<Window x:Class="WinAlign.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinAlign - Windows 11 Window Alignment" 
        Height="680" Width="880"
        MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Fluent Dark Styles -->
        <SolidColorBrush x:Key="CardBackground" Color="#202020" />
        <SolidColorBrush x:Key="CardBorder" Color="#2E2E2E" />
        <SolidColorBrush x:Key="AccentColor" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentHover" Color="#1084D8" />
        <SolidColorBrush x:Key="ButtonBg" Color="#2B2B2B" />
        <SolidColorBrush x:Key="ButtonHover" Color="#363636" />
        <SolidColorBrush x:Key="MutedText" Color="#9E9E9E" />

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="Button" x:Key="AnchorButtonStyle">
            <Setter Property="Background" Value="{StaticResource ButtonBg}" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#383838" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Footer / Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WinAlign" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <Border CornerRadius="4" Background="#1B3A57" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0 Windows 11" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Automatic 9-point grid alignment for newly opened windows" 
                           Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Indicator & Quick Test -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="EngineStatusBadge" CornerRadius="12" Background="#1E392A" Padding="10,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#4CC27A" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Engine Active" FontSize="12" FontWeight="SemiBold" Foreground="#6CCB5F" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="BtnAlignActiveNow" Content="🎯 Align Foreground Window" 
                        Padding="12,6" FontSize="12" FontWeight="SemiBold"
                        Background="#0078D4" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="OnAlignActiveNowClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT (Split Left / Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: 9-Grid Anchor Matrix & Quick Test -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Default Opening Alignment" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                        <TextBlock Text="Select where newly created windows will land on your monitor:" 
                                   Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <!-- Interactive 3x3 Monitor Grid Representation -->
                        <Border Background="#121212" BorderBrush="#333333" BorderThickness="2" CornerRadius="8" Padding="8">
                            <Grid x:Name="GridAnchors">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Row 0 -->
                                <Button x:Name="BtnTopLeft" Grid.Row="0" Grid.Column="0" Content="↖ Top-Left" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="TopLeft" />
                                <Button x:Name="BtnCenterTop" Grid.Row="0" Grid.Column="1" Content="↑ Center-Top" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="CenterTop" />
                                <Button x:Name="BtnTopRight" Grid.Row="0" Grid.Column="2" Content="↗ Top-Right" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="TopRight" />

                                <!-- Row 1 -->
                                <Button x:Name="BtnCenterLeft" Grid.Row="1" Grid.Column="0" Content="← Center-Left" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="CenterLeft" />
                                <Button x:Name="BtnCenterMiddle" Grid.Row="1" Grid.Column="1" Content="⦿ Center" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="CenterMiddle" />
                                <Button x:Name="BtnCenterRight" Grid.Row="1" Grid.Column="2" Content="→ Center-Right" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="CenterRight" />

                                <!-- Row 2 -->
                                <Button x:Name="BtnBottomLeft" Grid.Row="2" Grid.Column="0" Content="↙ Bottom-Left" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="BottomLeft" />
                                <Button x:Name="BtnCenterBottom" Grid.Row="2" Grid.Column="1" Content="↓ Center-Bottom" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="CenterBottom" />
                                <Button x:Name="BtnBottomRight" Grid.Row="2" Grid.Column="2" Content="↘ Bottom-Right" 
                                        Style="{StaticResource AnchorButtonStyle}" Margin="3" Click="OnAnchorButtonClicked" Tag="BottomRight" />
                            </Grid>
                        </Border>

                        <!-- Selected Anchor Status Text -->
                        <TextBlock x:Name="TxtSelectedAnchorDescription" Text="Active: Center-Middle" 
                                   Foreground="#60CDFF" FontSize="13" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Hotkey Tip Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Keyboard Shortcuts" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                        <TextBlock Text="• Ctrl + Alt + Space : Align active window to default" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2" />
                        <TextBlock Text="• Ctrl + Alt + Num 1..9 : Instantly snap active window to the matching numpad anchor" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT COLUMN: Settings, Exclusions, & Realtime Activity Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- SETTINGS CARD -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Behavior &amp; Display Settings" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                        
                        <CheckBox x:Name="ChkAutoAlign" Content="Auto-align newly opened windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <CheckBox x:Name="ChkCursorMonitor" Content="Align on monitor where mouse cursor is located" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <CheckBox x:Name="ChkHotkeys" Content="Enable global hotkeys (Ctrl+Alt+Space, Ctrl+Alt+NumPad 1-9)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <CheckBox x:Name="ChkStartup" Content="Start automatically with Windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                        <!-- Margin Slider -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Edge Margin:" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="SliderMargin" Grid.Column="1" Minimum="0" Maximum="40" SmallChange="2" LargeChange="4" 
                                    TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" 
                                    ValueChanged="OnMarginValueChanged" />
                            <TextBlock x:Name="TxtMarginValue" Grid.Column="2" Text="12 px" Foreground="#60CDFF" 
                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- EXCLUSIONS CARD -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Process Exclusions" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                        <TextBlock Text="Processes listed here will not be automatically moved:" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewExclusion" Background="#181818" Foreground="#FFFFFF" BorderBrush="#3A3A3A" 
                                     Padding="8,4" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="12,4" Background="#333333" Foreground="#FFFFFF" 
                                    BorderThickness="0" Click="OnAddExclusionClicked" Cursor="Hand" />
                            <Button Grid.Column="2" Content="Remove" Margin="6,0,0,0" Padding="12,4" Background="#333333" Foreground="#FFFFFF" 
                                    BorderThickness="0" Click="OnRemoveExclusionClicked" Cursor="Hand" />
                        </Grid>

                        <ListBox x:Name="ListExclusions" Height="65" Margin="0,8,0,0" Background="#181818" Foreground="#CCCCCC" 
                                 BorderBrush="#333333" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- ACTIVITY LOG CARD -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Live Activity Log" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <Button Content="Clear" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource MutedText}" 
                                    BorderThickness="0" FontSize="11" Cursor="Hand" Click="OnClearLogClicked" />
                        </Grid>

                        <ListBox x:Name="ListActivityLog" Grid.Row="1" Background="#121212" Foreground="#A9D49F" BorderBrush="#2A2A2A" 
                                 FontFamily="Consolas, monospace" FontSize="11" Padding="4" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER / TRAY HINT -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,4,0,0">
            <TextBlock Text="Tip: Minimizing or closing this window will send WinAlign to the system tray." 
                       Foreground="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
